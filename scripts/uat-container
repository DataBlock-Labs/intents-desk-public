#!/usr/bin/env bash
# Run the Docker image with an empty volume and point the smoke and browser checks at it.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
docker image inspect intents-desk:premerge >/dev/null 2>&1 || docker build -q -t intents-desk:premerge .
port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
name="desk-uat-$$"
docker run -d --rm --name "$name" -p "127.0.0.1:$port:8420" intents-desk:premerge >/dev/null
trap 'docker rm -f "$name" >/dev/null 2>&1' EXIT
base="http://127.0.0.1:$port"
for _ in $(seq 100); do curl -fs -o /dev/null "$base/" && break; sleep 0.3; done
BASE_URL="$base" uv run pytest -q -m "e2e and not live" -k "loads or phone"
code=$(curl -s -o /dev/null -w '%{http_code}' "$base/api/auth/challenge")
[ "$code" = 200 ] || { echo "uat-container: challenge -> $code"; docker logs "$name"; exit 1; }
echo "uat-container: ok ($base)"
